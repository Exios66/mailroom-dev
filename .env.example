# Langfuse — the sole source of truth for everything The-Mailroom displays.
# Project-scoped API keys from Langfuse → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# US cloud default; self-hosted or EU cloud otherwise.
# LANGFUSE_BASE_URL is accepted as an alias (Langfuse UI / some dashboards).
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Producer-only knobs (llm-mailroom). This visualizer is read-only and never
# constructs a Langfuse write client, so it does not flush or batch events.
# The producer now flushes after each graph node and the API embeds the
# inbox watcher so new uploads appear on the floor within one poll tick
# plus LANGFUSE_FLUSH_INTERVAL. Defaults stay the SDK's 512 events / 5s
# unless the producer sets a tighter interval (1s recommended for live).
# LANGFUSE_FLUSH_AT=512
# LANGFUSE_FLUSH_INTERVAL=1
# LANGFUSE_TIMEOUT=
# LANGFUSE_SAMPLE_RATE=
# LANGFUSE_RELEASE=mailroom@0.9.0
# MAILROOM_TRACE_USER_ID=

# Optional: restrict what the interface shows (Langfuse trace filters).
# MAILROOM_TRACE_TAGS=mailroom
# MAILROOM_TRACE_ENVIRONMENTS=live,pilot

# Poll cadence (seconds) and how many recent traces the floor keeps.
# Window default is 7 days so the live WebSocket snapshot matches the
# pixel / Observatory / TUI HTTP clients (`since=604800`).
# In-flight traces are re-enriched every poll so a just-flushed node
# moves the envelope on the next tick (terminal runs stay cached 60s).
MAILROOM_POLL_INTERVAL=3
MAILROOM_RECENT_WINDOW=604800
MAILROOM_TRACE_LIMIT=200

# Optional: llm-mailroom producer API on :8000 (watcher + inbox + human-review
# resolve + parked-document source). Display data stays Langfuse-only; this
# URL is operator liveness AND the server-side proxy for Approve / Reject /
# Record / Requeue / Complete, class correction, and the raw-text viewer.
# The browser never holds MAILROOM_PIPELINE_TOKEN.
#
# Prefer the producer's /v1 prefix (MAILROOM_PIPELINE_API_PREFIX=/v1, default).
# Class correction is forwarded as override_doc_type (the visualizer UI still
# posts doc_type; the proxy maps it).
#
# Do not confuse with MAILROOM_API_URL below — that is the TUI pointing at
# THIS visualizer (:8001), not the producer.
# MAILROOM_PIPELINE_URL=http://127.0.0.1:8000
# MAILROOM_PIPELINE_TOKEN=          # one live producer token (MAILROOM_API_TOKEN
#                                   # or a key from MAILROOM_API_TOKENS csv;
#                                   # MAILROOM_API_TOKEN_REVOKED subtracts retired keys)
# MAILROOM_PIPELINE_API=            # alias of MAILROOM_PIPELINE_URL
# MAILROOM_PIPELINE_API_PREFIX=/v1  # empty or / to use unversioned aliases

# Optional: path to the llm-mailroom checkout (production HF pilot runner
# and mailroom_ui/producer.py import fallback). Prefer the pip extra
# `pip install -e ".[pipeline]"` to pin dist mailroom @ 0928de1.
# MAILROOM_PIPELINE_ROOT=/path/to/llm-mailroom

# Hugging Face (docclass-merged / docclass-pilot subset for eval + pilots).
# HF_TOKEN=hf_...

# OpenRouter — only needed when running the sibling pipeline
# (`scripts/run_production_pilot.py --real`), not for the visualizer.
# OPENROUTER_API_KEY=sk-or-...

# HTTP server
MAILROOM_PORT=8001
# Bind address. 127.0.0.1 for the local pixel console; 0.0.0.0 for a
# public/container host (`mailroom-hosted` sets this for you).
# MAILROOM_HOST=127.0.0.1
# Which UI `/` serves: console (pixel-art, default) | hosted (Observatory).
# `/live` is always the Observatory when `hosted/` is present.
# MAILROOM_EDITION=console

# Optional: TUI → this visualizer (:8001). Prefer MAILROOM_PIPELINE_URL
# above for the producer. Never point MAILROOM_API_URL at producer :8000.
# MAILROOM_API_URL=http://localhost:8001

# ---- GH Pages edition ----------------------------------------------------

# Trace source selector: langfuse (default) | phoenix | both.
MAILROOM_SOURCE=langfuse

# Arize Phoenix (local debugging source). Requires `pip install arize-phoenix-client`.
PHOENIX_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# PHOENIX_CLIENT_HEADERS=Authorization=Bearer <key>
# MAILROOM_PHOENIX_PROJECT=default

# CORS origins allowed to call this API from a browser (the GitHub Pages site,
# served from https://<user>.github.io/<repo>/, needs this when it points at a
# locally running server). Comma-separated, * by default.
# MAILROOM_CORS_ORIGINS=*

# ---- Operator desk (operator_desk/) ---------------------------------------
# JWT / archive / ops / bin observer. Not a document-display source.
# MAILROOM_BASE_DIR=data
# MAILROOM_OPERATOR_DB=data/operator.db
# MAILROOM_OPERATOR_AUTH=1
# MAILROOM_OPERATOR_JWT_SECRET=          # dedicated secret; do not reuse
#                                        # MAILROOM_PIPELINE_TOKEN. JWT_SECRET
#                                        # is accepted as an alias.
# MAILROOM_OPERATOR_JWT_HOURS=24
# MAILROOM_OPERATOR_ADMIN_USER=admin
# MAILROOM_OPERATOR_ADMIN_PASSWORD=changeme
# MAILROOM_OPERATOR_INGEST_TOKEN=        # standalone mailroom-observer → POST /v1/ops/events
# MAILROOM_OBSERVER=0                    # 1 = in-process bin watcher (preferred)
# MAILROOM_UI_DIST=                      # optional React desk build dir (default ui/dist)
#                                        # GET /desk only when index.html exists there

# Verbose stdout request logging (ring buffer at /api/debug/logs is always on).
# Combined agent pull: GET /api/debug/bundle ; POST /api/debug/client from the Observatory Debug desk.
# MAILROOM_DEBUG=1
